OPENAI_API_KEY=
# Optional overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Job / contact emails (required for /api/job-application and /api/contact)
# Use a Gmail App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
JOB_APPLICATION_RECIPIENT=
CONTACT_RECIPIENT=

# Supabase CMS (public site + seed)
# Create project, run supabase/migrations/*.sql, then fill these in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service role: local seed only — never expose to the browser / Vercel client
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias used by seed script
# SUPABASE_URL=
